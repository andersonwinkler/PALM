# Makefile default variables for @xmltreemod MEX files
#
# Copyright (C) 1991-2014 Wellcome Trust Centre for Neuroimaging
# PALM adaptations for Octave, Apple Silicon, and MSYS2 (2026)
#
# Build for MATLAB (platform-specific .mex* suffix):
#   make matlab
#
# Build for Octave (generic .mex suffix):
#   make octave
#
# Auto-detect mex or mkoctfile in PATH:
#   make
#
# Override explicitly:
#   make RUNTIME=matlab
#   make RUNTIME=octave
#   make RUNTIME=matlab PLATFORM=Darwin
#   make RUNTIME=matlab SUF=mexa64

SHELL          = /bin/sh
MAKE           = make
UNAME          = uname
AR             = ar rcs
COPY           = cp -f
DEL            = rm -f
MOVE           = mv -f
TAR            = tar
ZIP            = gzip -f
MOSUF          = o

# Runtime: matlab | octave | auto
ifndef RUNTIME
  RUNTIME      = auto
endif
ifeq (auto,$(RUNTIME))
  ifneq ($(shell command -v mex 2>/dev/null),)
    RUNTIME    := matlab
  else ifneq ($(shell command -v mkoctfile 2>/dev/null),)
    RUNTIME    := octave
  else
    $(error Neither mex nor mkoctfile found in PATH. Install MATLAB or Octave, or set RUNTIME=matlab/octave with the compiler on PATH.)
  endif
endif

# Defaults for MATLAB builds
MEXBIN         = mex
MEXOPTS        = -O -largeArrayDims
MEXEND         =

ifndef SUF
  ifndef PLATFORM
    ifeq (octave,$(RUNTIME))
      PLATFORM   = octave
    else
      PLATFORM   = $(shell $(UNAME))
    endif
  endif

  ##### Octave (all host OS) #####
  ifeq (octave,$(PLATFORM))
    MEXBIN       = mkoctfile
    MEXOPTS      = --mex -O -Wno-deprecated-non-prototype
    SUF          = mex
  else
    ##### Linux #####
    ifeq (Linux,$(PLATFORM))
      HARDWARE   = $(shell $(UNAME) -m)
      ifneq (,$(filter i386 i686,$(HARDWARE)))
        SUF      = mexglx
      endif
      ifneq (,$(filter x86_64 amd64,$(HARDWARE)))
        SUF      = mexa64
      endif
      ifneq (,$(filter aarch64 arm64,$(HARDWARE)))
        SUF      = mexa64
      endif
      ifndef SUF
        $(error Unknown Linux architecture: $(HARDWARE))
      endif
    endif

    ##### macOS #####
    ifeq (Darwin,$(PLATFORM))
      HARDWARE   = $(shell $(UNAME) -m)
      ifneq (,$(filter x86_64 i386,$(HARDWARE)))
        SUF      = mexmaci64
      endif
      ifeq (arm64,$(HARDWARE))
        SUF      = mexmaca64
      endif
      ifndef SUF
        $(error Unknown macOS architecture: $(HARDWARE))
      endif
    endif

    ##### Windows (MATLAB mex.bat via cmd) #####
    ifneq (,$(filter MINGW32,$(word 1,$(subst _, ,$(PLATFORM)))))
      override PLATFORM = windows
    endif
    ifeq (windows,$(PLATFORM))
      ifeq (x86,$(PROCESSOR_ARCHITECTURE))
        SUF        = mexw32
      else
        SUF        = mexw64
      endif
      MEXBIN       = cmd /c "mex.bat
      MEXEND       = "
      MOSUF        = obj
      AR           = lib.exe /out:
    endif

    ##### Windows (MSYS2 / MinGW-w64, gcc-based mex) #####
    ifneq (,$(filter MSYS,$(word 1,$(subst _, ,$(PLATFORM)))))
      HARDWARE   = $(shell $(UNAME) -m)
      ifeq (i686,$(HARDWARE))
        SUF        = mexw32
      else
        SUF        = mexw64
      endif
      MOSUF        = obj
    endif

    ifndef SUF
      $(error Unknown platform: $(PLATFORM))
    endif
  endif
endif

MEX            = $(MEXBIN) $(MEXOPTS)

define verb
	@ echo "_____________________________________________________________"
	@ echo ""
	@ echo "  RUNTIME=$(RUNTIME)  PLATFORM=$(PLATFORM)  SUF=$(SUF)"
	@ echo "  $(1)"
	@ echo "_____________________________________________________________"
	@ echo ""
endef
