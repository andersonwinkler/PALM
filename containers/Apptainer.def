# Apptainer/Singularity definition file for PALM
# --------------------------------------------------------------
#
# Use this file if you want to build a container for PALM with
# Apptainer or Singularity.
# (For Docker, use Dockerfile in this directory instead;
# do not pass this .def file to "docker build".)
#
# Contents of the image:
#   - GNU Octave (base: docker.io/gnuoctave/octave)
#   - PALM from the GitHub "dev" branch
#   - Octave packages: image, statistics, specfun
#   - Compiled lib/ extensions ("make octave", including hdf5oct)
#
# Build (run from this directory; usually needs root or --fakeroot):
#   apptainer   build palm.sif Apptainer.def
#   singularity build palm.sif Apptainer.def
#
# Run (arguments after the image name are passed to palm):
#   apptainer   run palm.sif -h
#   singularity run palm.sif -h
#
# Bind a host data directory and run an analysis, e.g.:
#   apptainer run -B /path/to/data:/data palm.sif \
#     -i /data/mydata.nii -d /data/design.mat -t /data/design.con \
#     -o /data/results
#
# Or invoke the palm script explicitly:
#   apptainer   exec palm.sif /opt/PALM/palm -h
#   singularity exec palm.sif /opt/PALM/palm -h
#
# _______________________________________
# Juan M. Peralta and Anderson M. Winkler
# UTRGV
# June/2026

% - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
% PALM -- Permutation Analysis of Linear Models
% Copyright (C) 2015 Anderson M. Winkler
%
% This program is free software: you can redistribute it and/or modify
% it under the terms of the GNU General Public License as published by
% the Free Software Foundation, either version 3 of the License, or
% any later version.
%
% This program is distributed in the hope that it will be useful
% but WITHOUT ANY WARRANTY; without even the implied warranty of
% MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
% GNU General Public License for more details.
%
% You should have received a copy of the GNU General Public License
% along with this program.  If not, see <http://www.gnu.org/licenses/>.
% - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


Bootstrap: docker
From: docker.io/gnuoctave/octave:7.3.0 

%post
  cd /opt && git clone --branch dev "https://github.com/andersonwinkler/PALM" PALM
  sed -i -e 's,^#\(OCTAVEBIN=/usr/bin/octave\),\1,' -e 's,^\(OCTAVEBIN=/opt/local/bin/octave\),#\1,' /opt/PALM/palm
  chmod +x /opt/PALM/palm
  echo -e "\n\naddpath('/opt/PALM')\n" >> "$(octave-config --print LOCALSTARTUPFILEDIR)/octaverc"
  octave --quiet --eval "pkg install -forge image statistics specfun"
  cd /opt/PALM/lib
  make distclean
  make octave

%runscript
  /opt/PALM/palm
