// nextflow.config — companion settings for palm.nf
//
// This file configures *how* jobs run (executor, containers, resources).
// The workflow logic and PALM CLI wiring live in palm.nf.
//
// Profiles
// --------
//   -profile local   run processes on the current machine
//   -profile slurm   submit each process as a Slurm job
//
// Containers
// ----------
// Processes use Apptainer/Singularity (containerEngine below). Build the
// image from ../containers/Apptainer.def, e.g.:
//   apptainer build palm.sif Apptainer.def
// Place palm.sif where Nextflow can find it, or pass --container /path/to/palm.sif
//
// NXF_SINGULARITY_CACHEDIR, if set in the environment, is used as the
// Singularity/Apptainer cache directory.
//
// Resources
// ---------
// The run_palm process carries label 'palm_task'. Defaults below assume a
// typical imaging PALM job (single-threaded Octave, modest multi-GB memory).
// Override per run if needed, e.g.:
//   nextflow run palm.nf -profile slurm --dir_in ... \\
//     -process.memory '16 GB' -process.time '48h'
//
// _______________________________________
// Juan M. Peralta and Anderson M. Winkler
// UTRGV
// June/2026

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// PALM -- Permutation Analysis of Linear Models
// Copyright (C) 2015 Anderson M. Winkler
//
// This program is free software: you can redistribute it and/or modify
// it under the terms of the GNU General Public License as published by
// the Free Software Foundation, either version 3 of the License, or
// any later version.
//
// This program is distributed in the hope that it will be useful
// but WITHOUT ANY WARRANTY; without even the implied warranty of
// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
// GNU General Public License for more details.
//
// You should have received a copy of the GNU General Public License
// along with this program.  If not, see <http://www.gnu.org/licenses/>.
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Defaults mirrored from palm.nf so `nextflow config` shows them and so
// values can be overridden in one place when launching.
params {
    dir_out       = 'results'
    base_seed     = 1
    report_prefix = 'palm'
    container     = 'palm.sif'
    // Path inside the container image (see containers/Apptainer.def).
    palm_bin      = '/opt/PALM/palm'
    // false: publish out_<k>/ directories; true: publish out_<k>.tar.gz
    pack_results  = false
}

process {
    // Default executor; profiles below can override.
    executor = 'local'

    // palm.nf sets `container` on the process; this selects the engine
    // Nextflow uses to launch that image (Apptainer is Singularity-compatible).
    containerEngine = 'apptainer'

    // Applied to process run_palm (label 'palm_task' in palm.nf).
    // cpus = 1: PALM/Octave here is effectively single-threaded for the
    //           permutation workload; raising cpus rarely helps.
    // memory/time: starting points for volumetric/surface permutation jobs;
    //           large datasets or huge -n may need more.
    withLabel: 'palm_task' {
        cpus   = 1
        memory = '8 GB'
        time   = '24h'
    }
}

// Singularity/Apptainer global options (used when containerEngine is
// apptainer or singularity).
singularity {
    enabled    = true
    // Mount host paths that appear in the command into the container so
    // absolute paths in task.list (if any) can resolve.
    autoMounts = true
    cacheDir   = "$NXF_SINGULARITY_CACHEDIR"
}

profiles {

    // Development / small tests on a login node or laptop.
    local {
        process.executor = 'local'
    }

    // Production fan-out: each run_palm task becomes a Slurm job.
    // Adjust queue/partition name to match your site.
    slurm {
        process.executor = 'slurm'
        process.queue    = 'general'
        process.time     = '24h'
        process.memory   = '8 GB'
    }
}
